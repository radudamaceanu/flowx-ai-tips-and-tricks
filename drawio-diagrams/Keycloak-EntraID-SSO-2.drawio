<mxfile host="app.diagrams.net"><diagram name="Keycloak + Entra ID" id="kc-entra"><mxGraphModel dx="1400" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;FlowX SSO: Keycloak brokering Microsoft Entra ID&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=umlLifeline;participant=umlActor;perimeter=lifelinePerimeter;html=1;container=0;collapsible=0;recursiveResize=0;verticalAlign=top;spacingTop=36;outlineConnect=0;fontSize=13;size=60;" vertex="1" parent="1"><mxGeometry x="110" y="60" width="40" height="760" as="geometry"/></mxCell><mxCell id="c5" value="User" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="124" width="60" height="20" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;FlowX app&lt;/b&gt;&lt;br&gt;web app / Designer" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=13;size=60;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="180" height="760" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;FlowX org realm" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=13;size=60;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="180" height="760" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;corporate tenant" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=13;size=60;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="180" height="760" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;FlowX backend&lt;/b&gt;&lt;br&gt;runtime services" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=13;size=60;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="60" width="180" height="760" as="geometry"/></mxCell><mxCell id="c10" value="1. Open app" style="html=1;endArrow=block;endFill=1;rounded=0;verticalAlign=bottom;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="160" as="sourcePoint"/><mxPoint x="390" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="2. Redirect to Keycloak login&lt;br&gt;(client flowx-platform-authenticate)" style="html=1;endArrow=block;endFill=1;rounded=0;verticalAlign=bottom;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="220" as="sourcePoint"/><mxPoint x="650" y="220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="3. &amp;quot;Microsoft Entra ID&amp;quot; button&lt;br&gt;→ redirect (IdP alias entraid)" style="html=1;endArrow=block;endFill=1;rounded=0;verticalAlign=bottom;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="280" as="sourcePoint"/><mxPoint x="910" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="330" as="sourcePoint"/><mxPoint x="910" y="358" as="targetPoint"/><Array as="points"><mxPoint x="950" y="330"/><mxPoint x="950" y="358"/></Array></mxGeometry></mxCell><mxCell id="c14" value="4. Sign-in&lt;br&gt;(MFA, Conditional Access)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="956" y="324" width="170" height="40" as="geometry"/></mxCell><mxCell id="c15" value="5. Back to /broker/entraid/endpoint&lt;br&gt;token: groups = display names" style="html=1;endArrow=block;endFill=1;rounded=0;verticalAlign=bottom;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="410" as="sourcePoint"/><mxPoint x="650" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="450" as="sourcePoint"/><mxPoint x="650" y="478" as="targetPoint"/><Array as="points"><mxPoint x="690" y="450"/><mxPoint x="690" y="478"/></Array></mxGeometry></mxCell><mxCell id="c17" value="6. Create user if missing;&lt;br&gt;groups → entraidGroups" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="696" y="444" width="170" height="40" as="geometry"/></mxCell><mxCell id="c18" value="7. FlowX access token&lt;br&gt;attributes.runtimeGroups" style="html=1;endArrow=block;endFill=1;rounded=0;verticalAlign=bottom;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="530" as="sourcePoint"/><mxPoint x="390" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="8. API call — Authorization: Bearer &amp;lt;token&amp;gt;" style="html=1;endArrow=block;endFill=1;rounded=0;verticalAlign=bottom;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="590" as="sourcePoint"/><mxPoint x="1170" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="9. Validate token" style="html=1;endArrow=block;endFill=1;rounded=0;verticalAlign=bottom;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="650" as="sourcePoint"/><mxPoint x="650" y="650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="10. OK / KO + claims" style="html=1;endArrow=block;endFill=1;rounded=0;verticalAlign=bottom;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="700" as="sourcePoint"/><mxPoint x="1170" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="740" as="sourcePoint"/><mxPoint x="1170" y="768" as="targetPoint"/><Array as="points"><mxPoint x="1210" y="740"/><mxPoint x="1210" y="768"/></Array></mxGeometry></mxCell><mxCell id="c23" value="11. runtimeGroups vs&lt;br&gt;end-user groups (exact name)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1216" y="734" width="180" height="40" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;How the group names travel&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="400" height="24" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Entra token&lt;/b&gt;&lt;br&gt;claim &lt;i&gt;groups&lt;/i&gt;&lt;br&gt;(display names)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="175" height="80" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215" y="925" as="sourcePoint"/><mxPoint x="245" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;B.2 IdP mapper&lt;/b&gt;&lt;br&gt;Attribute Importer&lt;br&gt;sync mode Force" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="245" y="885" width="175" height="80" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="925" as="sourcePoint"/><mxPoint x="450" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Keycloak user&lt;/b&gt;&lt;br&gt;attribute &lt;i&gt;entraidGroups&lt;/i&gt;&lt;br&gt;(multivalued)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="450" y="885" width="175" height="80" as="geometry"/></mxCell><mxCell id="c30" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625" y="925" as="sourcePoint"/><mxPoint x="655" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;B.3 client mapper&lt;/b&gt;&lt;br&gt;flowx-platform-authenticate&lt;br&gt;-dedicated scope" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="655" y="885" width="175" height="80" as="geometry"/></mxCell><mxCell id="c32" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="925" as="sourcePoint"/><mxPoint x="860" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;FlowX access token&lt;/b&gt;&lt;br&gt;attributes.&lt;br&gt;runtimeGroups" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="885" width="175" height="80" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035" y="925" as="sourcePoint"/><mxPoint x="1065" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;B.5 end-user groups&lt;/b&gt;&lt;br&gt;Designer, matched&lt;br&gt;by exact name" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1065" y="885" width="175" height="80" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Part A: Entra ID&lt;/b&gt;&lt;ul style='margin:6px 0 0 -18px'&gt;&lt;li&gt;Security groups, direct members only (nested groups are not emitted). Names identical to the FlowX end-user groups&lt;/li&gt;&lt;li&gt;App registration &lt;i&gt;flowx-keycloak-broker&lt;/i&gt;, single tenant&lt;/li&gt;&lt;li&gt;Redirect URI: https://auth.&amp;lt;domain&amp;gt;/auth/realms/&amp;lt;realm&amp;gt;/broker/entraid/endpoint&lt;/li&gt;&lt;li&gt;Client secret: 24 months max, rotate before expiry&lt;/li&gt;&lt;li&gt;Groups assigned to the enterprise app; Assignment required = Yes in prod&lt;/li&gt;&lt;li&gt;Manifest: groupMembershipClaims = ApplicationGroup + cloud_displayname (ID and access token)&lt;/li&gt;&lt;li&gt;Graph delegated scopes openid, profile, email, offline_access, User.Read + admin consent&lt;/li&gt;&lt;li&gt;Handover: tenant ID, client ID, secret (secure channel), expiry date, discovery URL, group names&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;arcSize=3;fontSize=12;fillColor=#f5f9ff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="600" height="180" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Part B: Keycloak (in the realm from the token's iss)&lt;/b&gt;&lt;ul style='margin:6px 0 0 -18px'&gt;&lt;li&gt;B.0 Realm settings → User profile → Unmanaged attributes = Enabled&lt;/li&gt;&lt;li&gt;B.1 IdP OpenID Connect v1.0, alias &lt;i&gt;entraid&lt;/i&gt;, discovery endpoint, client secret sent as post; Trust Email On, Sync mode Force&lt;/li&gt;&lt;li&gt;B.2 IdP mapper: claim &lt;i&gt;groups&lt;/i&gt; → user attribute &lt;i&gt;entraidGroups&lt;/i&gt;&lt;/li&gt;&lt;li&gt;B.3 User Attribute mapper → &lt;i&gt;attributes.runtimeGroups&lt;/i&gt;; Multivalued, Aggregate, access token and introspection On&lt;/li&gt;&lt;li&gt;B.4 Local users: set &lt;i&gt;entraidGroups&lt;/i&gt; by hand&lt;/li&gt;&lt;li&gt;B.5 Designer → Access Management → End-Users Groups with identical names&lt;/li&gt;&lt;li&gt;Group changes apply at the next sign-in (no polling, no SCIM)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;arcSize=3;fontSize=12;fillColor=#faf6fc;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="670" y="1000" width="600" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>